@page "/create"
@inject ContentService Content
@inject CharacterService Characters
@inject DiceService Dice
@inject NavigationManager Nav

<PageTitle>New character · Valiant Sheet</PageTitle>

<div class="max-w-4xl mx-auto">
    <h1 class="display font-extrabold text-2xl" style="color:var(--ink)">Create a character</h1>
    @if (noCharacters)
    {
        <p class="muted">You don't have any saved characters yet. Let's build one.</p>
    }

    @* ---------- step indicator ---------- *@
    <ol class="flex flex-wrap gap-1.5 my-4">
        @for (int i = 0; i < Steps.Length; i++)
        {
            var idx = i;
            <li>
                <button type="button" class="btn btn-sm @(idx == step ? "btn-primary" : "")" disabled="@(idx > MaxReachable())" @onclick="() => step = idx">
                    @(idx + 1). @Steps[idx]
                </button>
            </li>
        }
    </ol>

    <div class="box p-4 sm:p-5">
        @switch (step)
        {
            case 0:
                <h2 class="box-title text-left">Who are you?</h2>
                <div class="grid sm:grid-cols-2 gap-4">
                    <div><label class="lbl">Character name</label><input class="field text-xl display" @bind="ch.Name" autocomplete="off" /></div>
                    <div><label class="lbl">Player name</label><input class="field text-xl" @bind="ch.PlayerName" /></div>
                </div>
                break;

            case 1:
                <h2 class="box-title text-left">Choose a lineage</h2>
                <p class="muted text-sm mb-3">Your lineage is your ancestry: size, speed and inborn traits.</p>
                <div class="grid sm:grid-cols-2 gap-2">
                    @foreach (var l in Content.Lineages)
                    {
                        var lin = l;
                        <button type="button" class="choice @(ch.Lineage?.Id == lin.Id ? "selected" : "")" @onclick="() => ch.Lineage = lin">
                            <div class="flex items-center gap-2"><span class="font-semibold">@lin.Name</span><span class="chip ml-auto">@lin.Source</span></div>
                            <div class="text-sm muted">@lin.Size · @lin.Speed ft.</div>
                            <div class="text-sm mt-1">@lin.Description</div>
                            <TraitList Traits="lin.Traits" />
                        </button>
                    }
                </div>
                break;

            case 2:
                <h2 class="box-title text-left">Choose a heritage</h2>
                <p class="muted text-sm mb-3">Your heritage is the culture you were raised in: languages and learned traits.</p>
                <div class="grid sm:grid-cols-2 gap-2">
                    @foreach (var h in Content.Heritages)
                    {
                        var her = h;
                        <button type="button" class="choice @(ch.Heritage?.Id == her.Id ? "selected" : "")" @onclick="() => PickHeritage(her)">
                            <div class="flex items-center gap-2"><span class="font-semibold">@her.Name</span><span class="chip ml-auto">@her.Source</span></div>
                            <div class="text-sm muted">Languages: @her.Languages@(her.LanguageChoices > 0 ? $" + {her.LanguageChoices} of your choice" : "")</div>
                            <div class="text-sm mt-1">@her.Description</div>
                            <TraitList Traits="her.Traits" />
                        </button>
                    }
                </div>
                if (ch.Heritage is { } herChosen)
                {
                    if (herChosen.SkillProficiencies.Count > 0)
                    {
                        <p class="mt-4 text-sm"><span class="lbl">Granted skills:</span> @string.Join(", ", herChosen.SkillProficiencies)</p>
                    }
                    if (herChosen.SkillChoices > 0 && herChosen.SkillOptions.Count > 0)
                    {
                        <h3 class="box-title text-left mt-5">@herChosen.Name skills: choose @HeritageSkillsNeeded()</h3>
                        <SkillPicker Options="herChosen.SkillOptions" Choices="HeritageSkillsNeeded()" Selected="ch.HeritageSkills"
                                     Owned="herChosen.SkillProficiencies.ToHashSet()" OwnedNote="Already granted by your heritage" Changed="PruneSkills" />
                    }
                    if (herChosen.LanguageChoices > 0)
                    {
                        <h3 class="box-title text-left mt-5">Extra languages: choose @herChosen.LanguageChoices</h3>
                        <div class="grid sm:grid-cols-2 gap-2">
                            @for (int i = 0; i < herChosen.LanguageChoices; i++)
                            {
                                var li = i;
                                <input class="field" aria-label="Language @(li + 1)" placeholder="Language @(li + 1)" autocomplete="off"
                                       value="@(li < ch.HeritageLanguages.Count ? ch.HeritageLanguages[li] : "")" @onchange="e => SetLanguage(li, e.Value?.ToString())" />
                            }
                        </div>
                        <p class="muted text-xs mt-1">See the heritage's traits for typical choices.</p>
                    }
                }
                break;

            case 3:
                <h2 class="box-title text-left">Choose a background</h2>
                <p class="muted text-sm mb-3">What you did before adventuring: skills, tools, equipment and a talent.</p>
                <div class="grid sm:grid-cols-2 gap-2">
                    @foreach (var b in Content.Backgrounds)
                    {
                        var bg = b;
                        <button type="button" class="choice @(ch.Background?.Id == bg.Id ? "selected" : "")" @onclick="() => PickBackground(bg)">
                            <div class="flex items-center gap-2"><span class="font-semibold">@bg.Name</span><span class="chip ml-auto">@bg.Source</span></div>
                            <div class="text-sm muted">Skills: @BackgroundSkillText(bg)@(string.IsNullOrEmpty(bg.ToolProficiencies) ? "" : $" · Tools: {bg.ToolProficiencies}")</div>
                            <div class="text-sm mt-1">@bg.Description</div>
                            <TraitList Traits="bg.Traits" />
                        </button>
                    }
                </div>
                if (ch.Background is { } bgChosen)
                {
                    if (bgChosen.SkillProficiencies.Count > 0)
                    {
                        <p class="mt-4 text-sm"><span class="lbl">Granted skills:</span> @string.Join(", ", bgChosen.SkillProficiencies)</p>
                    }
                    if (bgChosen.SkillChoices > 0 && bgChosen.SkillOptions.Count > 0)
                    {
                        <h3 class="box-title text-left mt-4">@bgChosen.Name skills: choose @BackgroundSkillsNeeded()</h3>
                        <SkillPicker Options="bgChosen.SkillOptions" Choices="BackgroundSkillsNeeded()" Selected="ch.BackgroundSkills"
                                     Owned="OwnedSkills(includeBackground: false)" OwnedNote="Already granted by your heritage or background" Changed="PruneSkills" />
                    }
                    if (bgChosen.TalentOptions.Count > 0)
                    {
                        <h3 class="box-title text-left mt-5">@bgChosen.Name talent: choose 1</h3>
                        <div class="grid sm:grid-cols-3 gap-2" role="radiogroup" aria-label="Background talent">
                            @foreach (var tid in bgChosen.TalentOptions)
                            {
                                var talentId = tid;
                                var opt = Content.Talent(talentId);
                                if (opt is null)
                                {
                                    <div class="choice opacity-60" title="Not in your enabled content">
                                        <div class="font-semibold">@talentId</div>
                                        <div class="text-xs muted">Unavailable: add or enable this talent in Content.</div>
                                    </div>
                                }
                                else
                                {
                                    var optTalent = opt;
                                    <button type="button" role="radio" aria-checked="@(ch.BackgroundTalent?.Id == optTalent.Id ? "true" : "false")"
                                            class="choice @(ch.BackgroundTalent?.Id == optTalent.Id ? "selected" : "")" @onclick="() => ch.BackgroundTalent = optTalent">
                                        <div class="flex items-center gap-2"><span class="font-semibold">@optTalent.Name</span><span class="chip ml-auto">@optTalent.Category</span></div>
                                        <div class="text-sm muted">@optTalent.Description</div>
                                    </button>
                                }
                            }
                        </div>
                    }
                }
                break;

            case 4:
                <h2 class="box-title text-left">Choose a class</h2>
                <div class="grid sm:grid-cols-2 gap-2">
                    @foreach (var c in Content.Classes)
                    {
                        var cls = c;
                        <button type="button" class="choice @(ch.Class?.Id == cls.Id ? "selected" : "")" @onclick="() => PickClass(cls)">
                            <div class="flex items-center gap-2"><span class="font-semibold">@cls.Name</span><span class="chip ml-auto">@cls.Source</span></div>
                            <div class="text-sm muted">d@(cls.HitDie) hit die · Saves: @string.Join(", ", cls.SavingThrows)@(cls.SpellcastingAbility is Ability sa ? $" · Casts with {sa}" : "")</div>
                            <div class="text-sm mt-1">@cls.Description</div>
                        </button>
                    }
                </div>
                if (ch.Class is { } chosen)
                {
                    <h3 class="box-title text-left mt-5">Choose @chosen.SkillChoices skills</h3>
                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var s in chosen.SkillOptions)
                        {
                            var skill = s;
                            var fromBg = OwnedSkills(includeBackground: true).Contains(skill);
                            var picked = ch.ClassSkills.Contains(skill);
                            <button type="button" class="btn btn-sm @(picked || fromBg ? "btn-primary" : "")"
                                    disabled="@(fromBg || (!picked && ch.ClassSkills.Count >= chosen.SkillChoices))"
                                    title="@(fromBg ? "Already granted by your heritage or background" : "")" @onclick="() => ToggleSkill(skill)">@skill</button>
                        }
                    </div>
                    <p class="muted text-sm mt-1">@ch.ClassSkills.Count of @chosen.SkillChoices chosen.</p>
                }
                break;

            case 5:
                <h2 class="box-title text-left">Ability scores</h2>
                <div class="flex flex-wrap gap-1.5 mb-3">
                    <button type="button" class="btn btn-sm @(method == "standard" ? "btn-primary" : "")" @onclick='() => SetMethod("standard")'>Standard array</button>
                    <button type="button" class="btn btn-sm @(method == "pointbuy" ? "btn-primary" : "")" @onclick='() => SetMethod("pointbuy")'>Point buy</button>
                    <button type="button" class="btn btn-sm @(method == "roll" ? "btn-primary" : "")" @onclick='() => SetMethod("roll")'>Roll 4d6</button>
                    <button type="button" class="btn btn-sm @(method == "manual" ? "btn-primary" : "")" @onclick='() => SetMethod("manual")'>Manual</button>
                </div>

                if (method == "pointbuy")
                {
                    <p class="text-sm mb-2">Points left: <span class="num @(PointsLeft() < 0 ? "fumble" : "")">@PointsLeft()</span> of @Rules.PointBuyBudget</p>
                }
                if (method == "roll")
                {
                    <div class="text-sm mb-2">
                        <button type="button" class="btn btn-sm btn-gold" @onclick="RollPool">Roll six scores</button>
                        @if (rolls.Count > 0)
                        {
                            <ul class="flex flex-wrap gap-1.5 mt-2" aria-label="Rolled scores">
                                @foreach (var roll in rolls)
                                {
                                    <li class="chip num" title="4d6, lowest die dropped">
                                        <span class="font-semibold">@roll.Take(3).Sum()</span>
                                        <span class="muted">[@string.Join(", ", roll.Take(3))<s class="ml-1">@roll[3]</s>]</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
                if (method is "standard" or "roll")
                {
                    <p class="muted text-sm mb-2">Assign each value to one ability.</p>
                }

                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2">
                    @foreach (var a in Rules.Abilities)
                    {
                        var ab = a;
                        <div class="field-box">
                            <div class="lbl">@Rules.AbilityNames[ab]</div>
                            @if (method is "standard" or "roll")
                            {
                                <select class="select num text-center" value="@(assign[(int)ab]?.ToString() ?? "")" @onchange="e => Assign(ab, e.Value?.ToString())">
                                    <option value="">—</option>
                                    @for (int i = 0; i < pool.Count; i++)
                                    {
                                        var pi = i;
                                        <option value="@pi" disabled="@(assign.Contains(pi) && assign[(int)ab] != pi)">@pool[pi]</option>
                                    }
                                </select>
                            }
                            else if (method == "pointbuy")
                            {
                                <div class="flex items-center justify-center gap-1">
                                    <button type="button" class="icon-btn" aria-label="Lower @ab" disabled="@(ch.BaseScores[(int)ab] <= Rules.PointBuyMin)" @onclick="() => Bump(ab, -1)">−</button>
                                    <span class="num text-xl w-8">@ch.BaseScores[(int)ab]</span>
                                    <button type="button" class="icon-btn" aria-label="Raise @ab" disabled="@(!CanRaise(ab))" @onclick="() => Bump(ab, 1)">+</button>
                                </div>
                            }
                            else
                            {
                                <input type="number" min="1" max="20" class="field num text-center text-xl" @bind="ch.BaseScores[(int)ab]" />
                            }
                            <div class="mt-1 text-sm">
                                @if (ch.PlusTwo == ab) { <span class="chip user">+2</span> }
                                @if (ch.PlusOne == ab) { <span class="chip user">+1</span> }
                                <span class="num">= @ch.FinalScore(ab) (@Rules.Signed(Rules.Mod(ch.FinalScore(ab))))</span>
                            </div>
                        </div>
                    }
                </div>

                if (method == "roll")
                {
                    <h3 class="box-title text-left mt-5">Rolled score bonus</h3>
                    <p class="muted text-sm mb-2">Add +2 to one score of @Rules.RolledPlusTwoMax or lower, and +1 to a different score of @Rules.RolledPlusOneMax or lower.</p>
                    <div class="grid sm:grid-cols-2 gap-3">
                        <div>
                            <label class="lbl" for="plus-two">+2 to</label>
                            <select id="plus-two" class="select" value="@(ch.PlusTwo?.ToString() ?? "")" @onchange="e => ch.PlusTwo = ParseAbility(e.Value)">
                                <option value="">—</option>
                                @foreach (var a in Rules.Abilities)
                                {
                                    <option value="@a" disabled="@(ch.PlusOne == a || ch.BaseScores[(int)a] > Rules.RolledPlusTwoMax)">@Rules.AbilityNames[a] (@ch.BaseScores[(int)a])</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="lbl" for="plus-one">+1 to</label>
                            <select id="plus-one" class="select" value="@(ch.PlusOne?.ToString() ?? "")" @onchange="e => ch.PlusOne = ParseAbility(e.Value)">
                                <option value="">—</option>
                                @foreach (var a in Rules.Abilities)
                                {
                                    <option value="@a" disabled="@(ch.PlusTwo == a || ch.BaseScores[(int)a] > Rules.RolledPlusOneMax)">@Rules.AbilityNames[a] (@ch.BaseScores[(int)a])</option>
                                }
                            </select>
                        </div>
                    </div>
                }
                break;

            case 6:
                <h2 class="box-title text-left">Starting equipment</h2>
                if (ch.Class is { } eqClass)
                {
                    <div class="flex flex-wrap gap-1.5 mb-3">
                        <button type="button" class="btn btn-sm @(!ch.TakeGoldInstead ? "btn-primary" : "")" @onclick="() => ch.TakeGoldInstead = false">Take @eqClass.Name gear</button>
                        <button type="button" class="btn btn-sm @(ch.TakeGoldInstead ? "btn-primary" : "")" @onclick="() => ch.TakeGoldInstead = true">Take @eqClass.StartingGold gp instead</button>
                    </div>
                    if (!ch.TakeGoldInstead)
                    {
                        <div class="grid sm:grid-cols-2 gap-1.5">
                            @foreach (var id in eqClass.StartingEquipment)
                            {
                                var itemId = id;
                                var item = Content.Item(itemId);
                                <label class="choice flex items-center gap-2 @(ch.EquipmentIds.Contains(itemId) ? "selected" : "")">
                                    <input type="checkbox" checked="@ch.EquipmentIds.Contains(itemId)" @onchange="() => ToggleItem(itemId)" />
                                    <span class="font-semibold">@(item?.Name ?? itemId)</span>
                                    <span class="muted text-sm ml-auto">@ItemSummary(item)</span>
                                </label>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="muted">Choose a class first.</p>
                }
                if (!string.IsNullOrWhiteSpace(ch.Background?.Equipment))
                {
                    <p class="mt-3 text-sm"><span class="lbl">From your background:</span> @(ch.Background!.Equipment)</p>
                }
                break;

            case 7:
                <h2 class="box-title text-left">Talent</h2>
                foreach (var bgTalent in new[] { Content.Talent(ch.Background?.TalentId ?? ""), ch.BackgroundTalent }.OfType<TalentDef>().DistinctBy(t => t.Id))
                {
                    <p class="mb-2">Your background grants <span class="font-semibold">@bgTalent.Name</span>. <span class="muted text-sm">@bgTalent.Description</span></p>
                }
                <p class="muted text-sm mb-2">Pick an additional talent if your lineage or GM grants one, or skip this step.</p>
                <div class="grid sm:grid-cols-2 gap-2">
                    @foreach (var t in Content.Talents)
                    {
                        var talent = t;
                        <button type="button" class="choice @(ch.Talent?.Id == talent.Id ? "selected" : "")" @onclick="() => ch.Talent = ch.Talent?.Id == talent.Id ? null : talent">
                            <div class="flex items-center gap-2"><span class="font-semibold">@talent.Name</span><span class="chip ml-auto">@talent.Category</span></div>
                            <div class="text-sm muted">@talent.Description</div>
                            @if (!string.IsNullOrEmpty(talent.Prerequisite))
                            {
                                <div class="text-xs mt-0.5">Prerequisite: @talent.Prerequisite</div>
                            }
                        </button>
                    }
                </div>
                break;

            default:
                var preview = CharacterBuilder.Create(ch, Content);
                <h2 class="box-title text-left">Review</h2>
                <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                        <div class="display font-extrabold text-2xl" style="color:var(--ink)">@preview.Name</div>
                        <div>@preview.ClassName 1 · @preview.LineageName · @preview.HeritageName · @preview.BackgroundName</div>
                        <div class="grid grid-cols-6 gap-1 mt-3 text-center">
                            @foreach (var a in Rules.Abilities)
                            {
                                <div class="field-box"><div class="lbl">@a</div><div class="num">@preview.Score(a)</div><div class="text-xs muted">@Rules.Signed(preview.Mod(a))</div></div>
                            }
                        </div>
                        <div class="flex gap-4 mt-3">
                            <span>HP <span class="num">@preview.MaxHp</span></span>
                            <span>AC <span class="num">@preview.ArmorClass(preview.EquippedShield() is not null)</span></span>
                            <span>Speed <span class="num">@preview.Speed</span></span>
                        </div>
                    </div>
                    <div class="text-sm space-y-1">
                        <div><span class="lbl">Skills</span> @string.Join(", ", preview.Skills.Keys.OrderBy(k => k))</div>
                        <div><span class="lbl">Features</span> @string.Join(", ", preview.Features.Select(f => f.Name))</div>
                        <div><span class="lbl">Talents</span> @(preview.Talents.Count == 0 ? "—" : string.Join(", ", preview.Talents.Select(t => t.Name)))</div>
                        <div><span class="lbl">Equipment</span> @string.Join(", ", preview.Weapons.Select(w => w.Name).Concat(preview.Armor.Select(x => x.Name)).Concat(preview.Gear.Select(g => g.Name)))</div>
                        <div><span class="lbl">Languages</span> @preview.Languages</div>
                    </div>
                </div>
                if (Problems().Any())
                {
                    <ul class="mt-4 text-sm" style="color:var(--danger)">
                        @foreach (var p in Problems())
                        {
                            <li>• @p</li>
                        }
                    </ul>
                }
                break;
        }

        <div class="flex items-center gap-2 mt-6 pt-3" style="border-top:1px solid var(--line)">
            <button type="button" class="btn" disabled="@(step == 0)" @onclick="() => step--">Back</button>
            @if (StepProblem() is { } problem)
            {
                <span class="muted text-sm">@problem</span>
            }
            @if (step < Steps.Length - 1)
            {
                <button type="button" class="btn btn-primary ml-auto" disabled="@(StepProblem() is not null)" @onclick="() => step++">Next</button>
            }
            else
            {
                <button type="button" class="btn btn-primary ml-auto" disabled="@Problems().Any()" @onclick="CreateCharacter">Create character</button>
            }
        </div>
    </div>
</div>

@code {
    private static readonly string[] Steps =
        { "Name", "Lineage", "Heritage", "Background", "Class", "Abilities", "Equipment", "Talent", "Review" };

    private readonly CreationChoices ch = new();
    private int step;
    private bool noCharacters;

    // ability score state
    private string method = "standard";
    private List<int> pool = Rules.StandardArray.ToList();
    private int?[] assign = new int?[6];
    private List<int[]> rolls = new();

    protected override async Task OnInitializedAsync()
    {
        await Content.EnsureLoadedAsync();
        await Characters.EnsureLoadedAsync();
        noCharacters = Characters.Characters.Count == 0;
        // Default the standard array in a sensible order.
        for (int i = 0; i < 6; i++) assign[i] = i;
        ApplyAssignments();
    }

    private string? StepProblem() => step switch
    {
        1 when ch.Lineage is null => "Choose a lineage.",
        2 when ch.Heritage is null => "Choose a heritage.",
        2 when ch.HeritageSkills.Count < HeritageSkillsNeeded() => $"Choose {HeritageSkillsNeeded() - ch.HeritageSkills.Count} more heritage skill(s).",
        2 when ch.HeritageLanguages.Count(l => !string.IsNullOrWhiteSpace(l)) < (ch.Heritage?.LanguageChoices ?? 0) => "Fill in your extra languages.",
        3 when ch.Background is null => "Choose a background.",
        3 when ch.BackgroundSkills.Count < BackgroundSkillsNeeded() => $"Choose {BackgroundSkillsNeeded() - ch.BackgroundSkills.Count} more background skill(s).",
        3 when NeedsBackgroundTalent() => "Choose a background talent.",
        4 when ch.Class is null => "Choose a class.",
        4 when ch.ClassSkills.Count < SkillsNeeded() => $"Choose {SkillsNeeded() - ch.ClassSkills.Count} more skill(s).",
        5 when method == "roll" && pool.Count == 0 => "Roll your scores.",
        5 when (method is "standard" or "roll") && assign.Any(a => a is null) => "Assign a value to every ability.",
        5 when method == "pointbuy" && PointsLeft() < 0 => "You've spent too many points.",
        5 when method == "roll" && (ch.PlusTwo is null || ch.PlusOne is null) => "Pick your +2 and +1.",
        5 when method == "roll" && !RolledBonusValid() => "The +2 needs a score of 16 or lower and the +1 a score of 17 or lower.",
        _ => null
    };

    private int MaxReachable()
    {
        int saved = step;
        int max = 0;
        for (int s = 0; s < Steps.Length - 1; s++)
        {
            step = s;
            if (StepProblem() is not null) break;
            max = s + 1;
        }
        step = saved;
        return Math.Max(max, step);
    }

    private IEnumerable<string> Problems()
    {
        if (ch.Lineage is null) yield return "No lineage chosen.";
        if (ch.Heritage is null) yield return "No heritage chosen.";
        if (ch.Background is null) yield return "No background chosen.";
        if (ch.Class is null) yield return "No class chosen.";
        if (ch.BackgroundSkills.Count < BackgroundSkillsNeeded()) yield return "Background skills not chosen.";
        if (NeedsBackgroundTalent()) yield return "Background talent not chosen.";
        if (ch.HeritageSkills.Count < HeritageSkillsNeeded()) yield return "Heritage skills not chosen.";
        if (method == "roll" && (ch.PlusTwo is null || ch.PlusOne is null || !RolledBonusValid())) yield return "Rolled score bonus not chosen.";
    }

    private int SkillsNeeded()
    {
        if (ch.Class is null) return 0;
        // Skills already granted elsewhere can't be picked again, so don't require more than are available.
        var owned = OwnedSkills(includeBackground: true);
        var available = ch.Class.SkillOptions.Count(s => !owned.Contains(s));
        return Math.Min(ch.Class.SkillChoices, available);
    }

    /// <summary>A talent pick is required only when at least one option exists in the enabled content.</summary>
    private bool NeedsBackgroundTalent() =>
        ch.Background is { } bg && ch.BackgroundTalent is null && bg.TalentOptions.Any(id => Content.Talent(id) is not null);

    /// <summary>After an earlier step's skills change, drop later picks that are now granted twice.</summary>
    private void PruneSkills()
    {
        var beforeBg = OwnedSkills(includeBackground: false);
        ch.BackgroundSkills.RemoveWhere(beforeBg.Contains);
        var all = OwnedSkills(includeBackground: true);
        ch.ClassSkills.RemoveWhere(all.Contains);
    }

    private int HeritageSkillsNeeded() =>
        ch.Heritage is { } h
            ? Math.Min(h.SkillChoices, h.SkillOptions.Count(s => !h.SkillProficiencies.Contains(s) || ch.HeritageSkills.Contains(s)))
            : 0;

    private int BackgroundSkillsNeeded()
    {
        if (ch.Background is not { } bg) return 0;
        var owned = OwnedSkills(includeBackground: false);
        return Math.Min(bg.SkillChoices, bg.SkillOptions.Count(s => !owned.Contains(s) || ch.BackgroundSkills.Contains(s)));
    }

    /// <summary>Skills already granted before the current step: heritage picks and,
    /// optionally, the background's fixed and chosen skills.</summary>
    private HashSet<string> OwnedSkills(bool includeBackground)
    {
        var set = new HashSet<string>(ch.HeritageSkills);
        if (ch.Heritage is { } her) set.UnionWith(her.SkillProficiencies);
        if (ch.Background is { } bg)
        {
            set.UnionWith(bg.SkillProficiencies);
            if (includeBackground) set.UnionWith(ch.BackgroundSkills);
        }
        return set;
    }

    private static string BackgroundSkillText(BackgroundDef bg)
    {
        var parts = new List<string>();
        if (bg.SkillProficiencies.Count > 0) parts.Add(string.Join(", ", bg.SkillProficiencies));
        if (bg.SkillChoices > 0 && bg.SkillOptions.Count > 0) parts.Add($"choose {bg.SkillChoices} of {string.Join(", ", bg.SkillOptions)}");
        return parts.Count == 0 ? "—" : string.Join("; ", parts);
    }

    private void PickHeritage(HeritageDef her)
    {
        if (ch.Heritage?.Id == her.Id) return;
        ch.Heritage = her;
        ch.HeritageSkills.Clear();
        ch.HeritageLanguages = new List<string>();
        PruneSkills();
    }

    private void SetLanguage(int index, string? value)
    {
        while (ch.HeritageLanguages.Count <= index) ch.HeritageLanguages.Add("");
        ch.HeritageLanguages[index] = value ?? "";
    }

    private void PickBackground(BackgroundDef bg)
    {
        if (ch.Background?.Id == bg.Id) return;
        ch.Background = bg;
        ch.BackgroundSkills.Clear();
        ch.BackgroundTalent = null;
        PruneSkills();
    }

    private void PickClass(ClassDef cls)
    {
        if (ch.Class?.Id == cls.Id) return;
        ch.Class = cls;
        ch.ClassSkills.Clear();
        ch.EquipmentIds = cls.StartingEquipment.ToHashSet();
    }

    private void ToggleSkill(string s)
    {
        if (!ch.ClassSkills.Remove(s) && ch.ClassSkills.Count < (ch.Class?.SkillChoices ?? 0)) ch.ClassSkills.Add(s);
    }

    private void ToggleItem(string id)
    {
        if (!ch.EquipmentIds.Remove(id)) ch.EquipmentIds.Add(id);
    }

    private static string ItemSummary(ItemDef? i) => i is null ? "" : i.Type switch
    {
        ItemType.Weapon => $"{i.Damage} {i.DamageType}",
        ItemType.Armor => $"AC {i.BaseAC} · {i.ArmorCategory}",
        ItemType.Shield => $"+{i.BaseAC} AC",
        _ => i.Cost
    };

    // ---------- ability scores ----------

    private bool RolledBonusValid() =>
        ch.PlusTwo is Ability two && ch.PlusOne is Ability one && two != one
        && ch.BaseScores[(int)two] <= Rules.RolledPlusTwoMax
        && ch.BaseScores[(int)one] <= Rules.RolledPlusOneMax;

    private bool CanRaise(Ability a)
    {
        var score = ch.BaseScores[(int)a];
        if (score >= Rules.PointBuyMax) return false;
        return PointsLeft() >= Rules.PointBuyCost(score + 1) - Rules.PointBuyCost(score);
    }

    private static Ability? ParseAbility(object? v) =>
        Enum.TryParse<Ability>(v?.ToString(), out var a) ? a : null;

    private void SetMethod(string m)
    {
        method = m;
        assign = new int?[6];
        ch.PlusTwo = null; // the +2/+1 bonus only applies to rolled scores
        ch.PlusOne = null;
        switch (m)
        {
            case "standard":
                pool = Rules.StandardArray.ToList();
                for (int i = 0; i < 6; i++) assign[i] = i;
                break;
            case "roll":
                pool = new List<int>();
                rolls = new List<int[]>();
                break;
            case "pointbuy":
                ch.BaseScores = new[] { 8, 8, 8, 8, 8, 8 };
                break;
            case "manual":
                ch.BaseScores = new[] { 10, 10, 10, 10, 10, 10 };
                break;
        }
        ApplyAssignments();
    }

    private void RollPool()
    {
        // Each roll is kept highest-first so the last die is the dropped one.
        rolls = Enumerable.Range(0, 6)
            .Select(n => Enumerable.Range(0, 4).Select(m => Dice.Die(6)).OrderByDescending(d => d).ToArray())
            .OrderByDescending(r => r.Take(3).Sum())
            .ToList();
        pool = rolls.Select(r => r.Take(3).Sum()).ToList();
        ch.PlusTwo = null;
        ch.PlusOne = null;
        assign = new int?[6];
        for (int i = 0; i < 6; i++) assign[i] = i;
        ApplyAssignments();
    }

    private void Assign(Ability a, string? raw)
    {
        assign[(int)a] = int.TryParse(raw, out var i) ? i : null;
        ApplyAssignments();
        // A re-assignment can push a score past the bonus limits; clear any choice that no longer fits.
        if (ch.PlusTwo is Ability two && ch.BaseScores[(int)two] > Rules.RolledPlusTwoMax) ch.PlusTwo = null;
        if (ch.PlusOne is Ability one && ch.BaseScores[(int)one] > Rules.RolledPlusOneMax) ch.PlusOne = null;
    }

    private void ApplyAssignments()
    {
        if (method is not ("standard" or "roll")) return;
        for (int i = 0; i < 6; i++)
            ch.BaseScores[i] = assign[i] is int idx && idx < pool.Count ? pool[idx] : 8;
    }

    private int PointsLeft() => Rules.PointBuyBudget - ch.BaseScores.Sum(s => Rules.PointBuyCost(s));

    private void Bump(Ability a, int delta) =>
        ch.BaseScores[(int)a] = Math.Clamp(ch.BaseScores[(int)a] + delta, Rules.PointBuyMin, Rules.PointBuyMax);

    // ---------- finish ----------

    private async Task CreateCharacter()
    {
        var c = CharacterBuilder.Create(ch, Content);
        await Characters.AddAsync(c);
        Nav.NavigateTo($"character/{c.Id}");
    }
}
